# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local now; replace with the production origin after deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only placeholders for later phases. Never prefix these with NEXT_PUBLIC_.
SUPABASE_STORAGE_BUCKET=product-assets
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SPEC_EXTRACTION_ENABLED=false
OPENAI_CREATIVE_MODEL=gpt-5-mini
OPENAI_CREATIVE_DERIVATION_ENABLED=false
OPENAI_CREATIVE_MAX_ATTEMPTS=2
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_GENERATION_ENABLED=false
# Keep one paid attempt per click by default. Manual retry is safer for Beta.
OPENAI_IMAGE_MAX_ATTEMPTS=1

# Local-only test session. Keep false in every deployed environment.
DEV_LOGIN_ENABLED=false
